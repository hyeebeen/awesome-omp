{
  // awesome-omp — markdownlint config
  // MD013 (line length) off: tables and Chinese text wrap naturally.
  // MD033 (inline HTML) off: not used, but keep it lenient for future anchors.
  "config": {
    "MD013": false,
    "MD033": false,
    // MD060 (table pipe spacing) off: generated tables use compact |a|b| rows.
    "MD060": false
  }
}
